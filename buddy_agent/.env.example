GOOGLE_API_KEY=your-gemini-api-key-here
BUDDYAI_MODEL=gemini-4-hydrogen
BUDDYAI_DOC_MODEL=gemini-4-hydrogen
BUDDYAI_TIMEZONE=Asia/Manila
# Optional: models BuddyAI may use, best first, comma-separated
# BUDDYAI_MODELS=gemini-4-hydrogen,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.6-flash,gemini-3.8-flash
# Optional: set to 0 to choose the next model yourself when one runs out
# BUDDYAI_AUTO_SWITCH=
# Optional: defaults to <project root>/data
# BUDDYAI_DATA_DIR=
