GOOGLE_API_KEY=your-gemini-api-key-here
BUDDYAI_MODEL=gemini-3.5-flash-lite
BUDDYAI_DOC_MODEL=gemini-3.5-flash-lite
BUDDYAI_TIMEZONE=Asia/Manila
# Optional: default city/place name for weather in daily briefings (defaults to Manila)
# BUDDYAI_LOCATION=Manila
# Optional: models BuddyAI may use, in order, comma-separated
# BUDDYAI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.6-flash,gemini-3.8-flash,gemini-4-hydrogen
# Optional: set to 0 to choose the next model yourself when one runs out
# BUDDYAI_AUTO_SWITCH=
# Optional: defaults to <project root>/data
# BUDDYAI_DATA_DIR=
# Optional: path to a read-only iCalendar (.ics) file to load at startup
# BUDDYAI_ICS_FILE=
# Optional: Gemini Live model for /voice (defaults to gemini-3.8-live)
# BUDDYAI_VOICE_MODEL=
